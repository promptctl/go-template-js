{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2024.String, not ES2024: `isWellFormed` is the oracle the
    // lone-surrogate sweep asserts with, and node 20.0 has it — but
    // full ES2024 would also admit `Object.groupBy` (node 21) and
    // `Promise.withResolvers` (node 22), above this package's declared
    // `engines.node` floor of 20.19.0. Component-level libs keep the
    // set of callable APIs a true map of the supported runtime.
    "lib": ["ES2022", "ES2024.String"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*", "tsdown.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
